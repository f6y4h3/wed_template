{
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.vitest.json"
    }
  ],
  "include": [
     "src/**/*/.vue",
     "src/**/*.d.ts",
     "src/**/*.ts",
     "src/types/global.d.ts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "baseUrl":"src",
    "paths": {
      "@/*": ["./*"],
      "@": ["./"]
    },
    "types": ["element-plus/global","vite/client"],
    "moduleResolution": "Node",
  }
}
